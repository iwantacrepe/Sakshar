# Copy to .env and fill in.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (vLLM, Azure, Groq, Ollama /v1 ...)
OPENAI_BASE_URL=

# Hugging Face token (accept terms for ai4bharat/indictrans2-* and ai4bharat/indic-parler-tts first)
HF_TOKEN=

# Windows default install path of Tesseract (choco / UB Mannheim)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

ENABLE_VOICE=true
# llm = OpenAI writes text_local directly; indictrans2 = translate text_en offline
TRANSLATION_ENGINE=llm
# cuda | cpu
DEVICE=cuda

REVIEW_THRESHOLD=0.75
REVIEW_THRESHOLD_STRICT=0.85
MASK_PII=true
DATA_DIR=data
